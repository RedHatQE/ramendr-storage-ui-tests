# Local credentials/config for ramendr-storage-ui-tests.
#
# Copy this file to `.env` (already gitignored) and fill in real values.
# `.env` is loaded automatically by the root conftest.py for `pytest` runs
# only (see config/env_file.py) -- real exported environment variables
# (shell/CI secret store) always take priority over values in `.env`.
#
# `.env` is NOT read by any Cursor MCP server. The two Atlassian/Jira MCPs
# configured for this workspace get their credentials from their own,
# separate, non-repo locations:
#   - "jiraMcp" MCP  -> env-file at ~/.rh-jira-mcp.env (JIRA_URL, JIRA_EMAIL,
#     JIRA_API_TOKEN, JIRA_ENABLE_WRITE)
#   - "quarterly" MCP -> inline `env` block in ~/.cursor/mcp.json (JIRA_URL,
#     JIRA_EMAIL, JIRA_API_TOKEN, GITHUB_TOKEN)
# Update those files directly to rotate MCP tokens; this .env only affects
# this repository's own test/reporting code.

# --- Jira Test Result reporting (reporting/jira_client.py) ---------------
# Only required if JIRA_REPORT_RESULTS=true and JIRA_REPORT_DRY_RUN=false.
# This is a separate Jira credential from either MCP above -- do not assume
# it is the same token.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Reporting feature flags (not secrets, but gate whether the above
# credentials are required at all). Defaults shown; uncomment to override.
# JIRA_REPORT_RESULTS=false
# JIRA_REPORT_DRY_RUN=true

# --- Hub console login override (config/settings.py) ----------------------
# Optional: by default the hub kubeadmin password is read from
# <hub kubeconfig dir>/kubeadmin-password. Only set this to override.
# RAMENDR_HUB_PASSWORD=
